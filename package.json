{
  "name": "meowpick-weapp",
  "version": "3.1.6",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "GPL v2",
  "scripts": {
    "dev:h5": "uni",
    "predev:mp-weixin": "yarn api",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "prebuild:mp-weixin": "yarn api",
    "build:mp-weixin": "uni build -p mp-weixin",
    "api": "npx swagger-typescript-api -p src/swagger.json -o ./src/api --modular --templates ./templates/modular --axios --enum-names-as-values --module-name-first-tag --single-http-client",
    "theme:gen": "node scripts/gen-theme-colors.mjs",
    "theme:check": "node scripts/gen-theme-colors.mjs --check",
    "icons:gen": "node scripts/gen-icons.mjs",
    "icons:check": "node scripts/gen-icons.mjs --check",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.vue --ignore-path .eslintignore",
    "lint:fix": "eslint . --ext .js,.ts,.vue --ignore-path .eslintignore --fix",
    "prepare": "husky install",
    "release": "release-it"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-3090920231225001",
    "@dcloudio/uni-components": "3.0.0-3090920231225001",
    "@dcloudio/uni-h5": "3.0.0-3090920231225001",
    "@dcloudio/uni-mp-weixin": "3.0.0-3090920231225001",
    "axios": "^0.27.2",
    "nutui-uniapp": "^1.6.4",
    "pinia": "2.0.36",
    "pinia-plugin-unistorage": "^0.0.17",
    "vue": "^3.2.47"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@dcloudio/types": "^3.4.7",
    "@dcloudio/uni-automator": "3.0.0-3090920231225001",
    "@dcloudio/uni-cli-shared": "3.0.0-3090920231225001",
    "@dcloudio/uni-stacktracey": "3.0.0-3090920231225001",
    "@dcloudio/vite-plugin-uni": "3.0.0-3090920231225001",
    "@release-it/conventional-changelog": "^5.1.1",
    "@types/node": "^20.11.5",
    "@types/wechat-miniprogram": "^3.4.7",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@uni-helper/uni-app-types": "^1.3.0",
    "@uni-helper/vite-plugin-uni-components": "^0.0.8",
    "@vue/runtime-core": "3.2.47",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.26.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.10",
    "miniprogram-ci": "^1.9.10",
    "prettier": "^2.8.3",
    "release-it": "^15.10.1",
    "sass": "^1.70.0",
    "swagger-typescript-api": "^13.0.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "4.0.3",
    "vue-tsc": "^2.2.12"
  }
}
